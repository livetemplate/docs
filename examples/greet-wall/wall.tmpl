<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Greeting wall</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="{{lvtClientStyleURL}}">
    <script defer src="{{lvtClientScriptURL}}"></script>
</head>
<body>
    <!-- Styles live in <body>: embed-lvt drops the embedded app's <head>, so
         anything in <head> is lost once this app is mounted on the landing. -->
    <style>
        /* The server line and the greeting rows are one column: both start at
           the container's left edge, so the heartbeat reads as the newest entry
           above the wall rather than as a floating caption. Centring one and
           left-aligning the other is what made them look unrelated. */
        .from-server{display:flex;align-items:center;gap:.45rem;
            font-size:.82rem;color:#6B6862;margin:.2rem 0 .9rem}
        .wall{margin:0;padding:0}
        /* Pico sets `ul li{list-style:square}` on the li itself, so a
           list-style on the ul never wins — it has to be stated here. */
        .wall li{list-style:none;padding:2px 0}
        .wall b{font-weight:500;color:#1B1A17}
        .wall small{color:#6B6862;font-size:.82rem}
        /* The pulse stays. The design's rule is that nothing moves unless the
           app is updating — and this dot marks a server-initiated push, which
           is exactly the app updating. Only the hue changes, to the calm
           live-status green. */
        .from-server .dot{flex:none;width:8px;height:8px;border-radius:50%;background:#5C9169;
            animation:fromServerPulse 2s ease-out infinite}
        @keyframes fromServerPulse{
            0%{box-shadow:0 0 0 0 rgba(92,145,105,.5)}
            70%{box-shadow:0 0 0 7px rgba(92,145,105,0)}
            100%{box-shadow:0 0 0 0 rgba(92,145,105,0)}}
        @media(prefers-reduced-motion:reduce){.from-server .dot{animation:none}}
    </style>
    <main class="container">
        <h1>Hello, {{.Name}}</h1>
        <form method="POST">
            <input name="name" placeholder="Your name" {{.lvt.AriaInvalid "name"}}>
            {{.lvt.ErrorTag "name"}}
            <button name="greet">Say hi</button>
        </form>
        <!-- Step 7: the server speaks first. A single slot the server REPLACES
             in place on its heartbeat — never a row appended to the wall. -->
        {{if .ServerAt}}<p class="from-server"><span class="dot"></span> the server said hi at <b>{{.ServerAt}}</b></p>{{end}}
        <ul class="wall">
            {{range .Wall}}<li><b>{{.Name}}</b> said hi <small>{{.At}}</small></li>{{end}}
        </ul>
    </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title>Hello (no JavaScript)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="{{lvtClientStyleURL}}">
    <script defer src="{{lvtClientScriptURL}}"></script>
    <!-- The calm theme, restated here. This app is shown on the landing inside
         an <iframe>, and CSS does not cross that boundary — so unlike the other
         demos (which the landing styles directly) this one has to carry the
         palette itself, or the JS-off card would not match the JS-on card
         beside it. The font is self-hosted and same-origin, so the sandboxed
         frame can load it under font-src 'self'. -->
    <style>
        @font-face{font-family:'IBM Plex Sans';font-style:normal;font-weight:400;font-display:swap;src:url('/assets/fonts/plexsans-400.woff2') format('woff2')}
        @font-face{font-family:'IBM Plex Sans';font-style:normal;font-weight:500;font-display:swap;src:url('/assets/fonts/plexsans-500.woff2') format('woff2')}
        @font-face{font-family:'IBM Plex Sans';font-style:normal;font-weight:600;font-display:swap;src:url('/assets/fonts/plexsans-600.woff2') format('woff2')}
        :root{
            color-scheme:light;
            --pico-background-color:#fff;
            --pico-color:#1B1A17;
            --pico-muted-color:#6B6862;
            --pico-form-element-background-color:#FBFAF8;
            --pico-form-element-border-color:#DCD8D0;
            --pico-form-element-color:#1B1A17;
            --pico-primary:#1B1A17;
            --pico-primary-background:#1B1A17;
            --pico-primary-border:#1B1A17;
            --pico-primary-hover:#2F5D8A;
            --pico-primary-hover-background:#2F5D8A;
            --pico-primary-hover-border:#2F5D8A;
        }
        *,*::before,*::after{box-sizing:border-box}
        html,body{margin:0;background:#fff !important;color:#4A4842 !important}
        body{font-family:'IBM Plex Sans',system-ui,-apple-system,sans-serif;background:#fff !important}
        main.container{max-width:none;margin:0;padding:24px;background:#fff}
        h1{font-size:26px;font-weight:600;letter-spacing:-.015em;margin:0 0 18px;color:#1B1A17 !important}
        form{display:flex;flex-wrap:wrap;align-items:stretch;gap:8px;margin:0}
        input,button[name="greet"]{font:400 14px/1.25 'IBM Plex Sans',system-ui,sans-serif}
        /* Pico sizes inputs with input:not([type=checkbox]){width:100%} — a
           bare `input` selector ties on specificity and loses, so the width
           has to be stated on a selector that outranks it. */
        form input[name="name"]{margin:0;width:190px;flex:0 0 auto;min-width:0;padding:8px 12px;
            background:#FBFAF8 !important;color:#1B1A17 !important;border:1px solid #DCD8D0 !important;
            border-radius:5px;box-shadow:none;appearance:none}
        button[name="greet"]{--pico-background-color:#1B1A17;--pico-border-color:#1B1A17;
            background:#1B1A17 !important;border:1px solid #1B1A17 !important;color:#FBFAF8 !important;
            width:auto;white-space:nowrap;padding:8px 16px;border-radius:5px;font-weight:500;
            display:inline-flex;align-items:center;justify-content:center;appearance:none}
        button[name="greet"]:hover{background:#2F5D8A !important;border-color:#2F5D8A !important}
    </style>
</head>
<body>
    <main class="container">
        <h1>Hello, {{.Name}}</h1>
        <form method="POST">
            <input name="name" placeholder="Your name">
            <button name="greet">Say hi</button>
        </form>
    </main>
</body>
</html>
